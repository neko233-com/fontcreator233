# Generated build output — never commit
/dist/
/out/
/work/
/build/
/tmp/
/.fontcreator233/
/.superpowers/
*.bundle.zip

# Generated fonts and web artifacts outside the embedded base
/*.ttf
/*.woff
/*.woff2
/*.specimen.html
/*.glyphs.js
/fonts/
/specimen/

# Local test projects and reports
/UnityProject/
/UnrealProject/
/playwright-report/
/test-results/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Go
*.exe
*.test
*.out
coverage.out

# Explicitly keep embedded source assets and vendored web assets
!assets/base/*.ttf
!assets/base/*.txt
!internal/specimen/webassets/**
